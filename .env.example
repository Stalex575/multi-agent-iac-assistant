# Only this key is required.
GOOGLE_API_KEY=replace-with-google-ai-studio-api-key

# Models (Gemini free tier). Quotas are per model, so roles are spread across models.
# HEAVY = generator / advisor / explainer, FAST = router / collector, JUDGE = LLM-as-judge in evals only.
GEMINI_HEAVY_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Client-side rate limits in requests/minute, per model (keep just under the quota).
LLM_RPM=14
JUDGE_RPM=4

# Behaviour
SEMANTIC_CACHE_THRESHOLD=0.94
MAX_FIX_RETRIES=2
MAX_FOLLOWUP_TURNS=3
RETRIEVAL_TOP_K=6
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

# Optional LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=...
# LANGCHAIN_PROJECT=infrapilot
